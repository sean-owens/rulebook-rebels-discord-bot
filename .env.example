DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Optional: set this to deploy commands to a single guild instantly (for dev).
# Remove it (or leave blank) to deploy commands globally.
DISCORD_GUILD_ID=your_guild_id_here

# BGG session cookie (temporary — paste the full Cookie header value from DevTools while logged in to boardgamegeek.com)
# DevTools → Network → any BGG request → Request Headers → Cookie
BGG_SESSION_COOKIE=

# BGG official API token (replace session cookie once approved)
# BGG_API_KEY=your_token_here

# Verbose per-request BGG logging (src/utils/bgg.ts) — logs every BGG call's
# URL, HTTP status, attempt number, elapsed time, and whether it succeeded,
# retried, or failed for good. Off by default (a syncall of hundreds of
# games would otherwise flood logs with routine 200s) — flip to true only
# while diagnosing a live BGG issue.
# BGG_DEBUG_LOGGING=true

# S3-backed persistence (required in production — e.g. Railway wipes the local filesystem on every deploy).
# Leave unset for local dev to fall back to JSON files under data/.
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=https://your-s3-compatible-endpoint (omit for real AWS S3)

# Public base URL for this bot's own short-link redirect service (see
# src/utils/shortLinkServer.ts), used to keep the BG Stats "Log in BG Stats"
# button under Discord's 512-char link limit regardless of player count.
# Must match a public domain generated for this Railway service (Settings ->
# Networking -> Generate Domain). Leave unset to disable: the button then
# only appears when the full BG Stats link is already short enough on its own.
# SHORT_LINK_BASE_URL=https://your-service.up.railway.app

# Discord user ID to DM a weekly reminder to check for a newer BGG catalog
# dump (see src/utils/bggCatalogReminder.ts). This is a maintainer-only nudge
# (updating BGG/backup-data/ requires a code change + redeploy), not a
# per-guild setting. Leave unset to disable the reminder entirely.
# BGG_CATALOG_MAINTAINER_ID=your_discord_user_id_here
